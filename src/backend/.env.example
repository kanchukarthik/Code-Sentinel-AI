# CodeSentinel AI Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider: 'mock' (default, offline, zero API keys needed), 'gemini', 'openai', 'anthropic', 'ollama'
LLM_PROVIDER=mock
ACTIVE_MODEL=claude-3-7-sonnet

# Optional Provider API Keys (leave empty for mock mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Autonomous Policy: 'human_review', 'auto_approve_high_confidence', 'autonomous'
DEFAULT_AUTO_HEAL_POLICY=human_review
DEFAULT_CONFIDENCE_THRESHOLD=0.85
DEFAULT_MAX_REPAIR_ITERATIONS=3

# Sandbox Safety Limits
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MAX_MEMORY_MB=512
